final_df <- map_dfr(seq_along(predictions_pelagia_interpolated), function(i) {
predictions_pelagia_interpolated[[i]]$contours %>%
dplyr::select(lon, lat, prob_0, prob_1, prob_2, heat) %>%
mutate(
forecast_day = i - 1,   # 0 = today, 1 = tomorrow, 2 = day + 2
forecast_date = as.character(today_date + (i - 1))
)
})
